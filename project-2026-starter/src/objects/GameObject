package objects;

import pt.iscte.poo.gui.ImageTile;
import pt.iscte.poo.utils.Point2D;

public abstract class GameObject implements ImageTile {

	private Point2D position;
	private String imageName;
	private int layer;

	/**
	 * Constructs a new GameObject with a position, image name and drawing layer.
	 */
	public GameObject(Point2D position, String imageName, int layer) {
		this.position = position;
		this.imageName = imageName;
		this.layer = layer;
	}

	/**
	 * Returns the current grid position of the object.
	 */
	@Override
	public Point2D getPosition() {
		return position;
	}

	/**
	 * Updates the grid position of the object.
	 */
	public void setPosition(Point2D position) {
		this.position = position;
	}

	/**
	 * Returns the image name without file extension.
	 */
	@Override
	public String getName() {
		return imageName;
	}

	/**
	 * Updates the image name of the object.
	 */
	protected void setImageName(String imageName) {
		this.imageName = imageName;
	}

	/**
	 * Returns the drawing layer of the object.
	 */
	@Override
	public int getLayer() {
		return layer;
	}

	/**
	 * Returns true if other objects can enter the cell occupied by this object.
	 */
	public boolean isPassable() {
		return true;
	}
}